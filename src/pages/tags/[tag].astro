---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../utils';
export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params; const { posts } = Astro.props;
---
<Base title={`Tag: ${tag}`}>
  <div class="page-head"><p class="eyebrow">Tag</p><h1>#{tag}</h1><p class="muted">{posts.length} post{posts.length === 1 ? '' : 's'} · <a href="/tags/">All tags</a></p></div>
  <PostList posts={posts} />
</Base>
<style>.page-head { padding: var(--space-8) 0 var(--space-5); } .page-head h1 { margin: var(--space-2) 0; }</style>
