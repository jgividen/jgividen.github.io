.prose :global(> * + *) { margin-top: var(--space-5); }
.prose :global(p) { margin-bottom: 0; }
.prose :global(h2) { margin-top: var(--space-7); font-size: var(--text-2xl); line-height: var(--leading-snug); }
.prose :global(h3) { margin-top: var(--space-6); line-height: var(--leading-snug); }
.prose :global(strong) { font-weight: 650; }
