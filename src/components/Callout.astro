---
interface Props { type?: 'note' | 'tip' | 'warning'; title?: string }
const { type = 'note', title } = Astro.props;
const icons = { note: 'ℹ', tip: '✦', warning: '!' };
---
<aside class:list={['callout', `callout--${type}`]} role="note">
  <span class="icon" aria-hidden="true">{icons[type]}</span>
  <div>{title && <p class="title">{title}</p>}<slot /></div>
</aside>
<style>
.callout { display: flex; gap: var(--space-3); padding: var(--space-4) var(--space-5); border-radius: var(--radius-md);
  border: 1px solid var(--border); border-left: 4px solid var(--c); background: var(--surface); margin: var(--space-5) 0; }
.callout--note { --c: var(--info); } .callout--tip { --c: var(--accent); } .callout--warning { --c: var(--warning); }
.icon { flex: none; width: 1.6rem; height: 1.6rem; border-radius: 50%; display: grid; place-items: center;
  background: var(--c); color: var(--bg); font-weight: 700; font-size: var(--text-sm); }
.title { font-weight: 700; margin: 0 0 var(--space-1); }
.callout :global(p) { margin: 0; }
</style>
