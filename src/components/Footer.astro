---
import { SITE_TITLE } from '../consts';
---
<footer class="site-footer">
  <div class="wrap row">
    <p>© {new Date().getFullYear()} {SITE_TITLE}</p>
    <p class="links"><a href="https://github.com/jgividen">GitHub</a><a href="/rss.xml">RSS</a><a href="/design/">Design system</a><a href="/subvault/">SubVault</a><a href="/coi-tracking-spreadsheet/">Free COI spreadsheet</a></p>
  </div>
</footer>
<style>
.site-footer { margin-top: var(--space-9); border-top: 1px solid var(--border); color: var(--text-muted); font-size: var(--text-sm); }
.row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); padding-block: var(--space-5); }
p { margin: 0; } .links { display: flex; flex-wrap: wrap; gap: var(--space-4); }
a { color: var(--text-muted); } a:hover { color: var(--accent-strong); }
</style>
